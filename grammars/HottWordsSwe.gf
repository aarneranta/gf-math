concrete HottWordsSwe of HottWords = CategoriesSwe **

open UtilitiesSwe, ParadigmsSwe in {

lin homotopic_Adj = mkAdj "homotopisk" ;
lin reflexivity_Noun = mkNoun (mkN "reflexivitet" "reflexiviteter") ;

-- the words that the Mathlib informalization uses
lin coprime_Adj = mkAdj (mkA "relativt prima" "relativt prima" "relativt prima" "relativt prima" "relativt prima") ;
lin factor_Noun = mkNoun (mkN "faktor" "faktorer") ;
lin predecessor_Noun = mkNoun (mkN "föregångare" "föregångaren" "föregångare" "föregångarna" utrum) ;
lin preorder_Noun = mkNoun (mkN "kvasiordning" "kvasiordningar") ;
lin procedure_Noun = mkNoun (mkN "procedur" "procedurer") ;
lin supremum_Noun = mkNoun (mkN "supremum" "supremumet" "suprema" "supremumen" neutrum) ;

}
