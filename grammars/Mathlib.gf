abstract Mathlib = Categories ** {

-- words of the informalization of Lean's Mathlib (mathlib-informath): the
-- wordings of Mathlib's docstrings that the rest of the lexicon lacks

fun smallest_Adj : Adj ;
fun descending_Adj : Adj ;
fun finitely_supported_Adj : Adj ;
fun bounded_above_Adj : Adj ;
fun bounded_below_Adj : Adj ;
fun ceiling_Noun : Noun ;
fun partially_ordered_Adj : Adj ;
fun linearly_ordered_Adj : Adj ;
fun trichotomous_Adj : Adj ;
fun lower_Adj : Adj ;

-- sets named after their elements, as Mathlib's Finset-valued functions are
fun set_of_divisors_Noun : Noun ;
fun set_of_proper_divisors_Noun : Noun ;
fun set_of_prime_factors_Noun : Noun ;

}
