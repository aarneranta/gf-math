concrete HottWordsCze of HottWords = CategoriesCze **

open UtilitiesCze, ParadigmsCze in {

lin homotopic_Adj = mkAdj (mkA "homotopický") ;
lin reflexivity_Noun = mkNoun (mkN "reflexivita" "reflexivity" feminine) ;

-- words of the Mathlib informalization
lin coprime_Adj = mkAdj (mkA "nesoudělný") ;
lin factor_Noun = mkNoun (mkN "faktor" "faktoru" mascInanimate) ;
lin predecessor_Noun = mkNoun (mkN "předchůdce" "předchůdce" mascAnimate) ;
lin preorder_Noun = mkNoun (mkN "předuspořádání" "předuspořádání" neuter) ;
lin procedure_Noun = mkNoun (mkN "procedura" "procedury" feminine) ;
lin supremum_Noun = mkNoun (mkN "supremum" "suprema" neuter) ;

}
