concrete HottWordsGer of HottWords = CategoriesGer **

-- partial: the words that the Mathlib informalization uses

open UtilitiesGer, ParadigmsGer in {

lin coprime_Adj = mkAdj (mkA "teilerfremd") ;
lin factor_Noun = mkNoun (mkN "Faktor" "Faktoren" masculine) ;
lin predecessor_Noun = mkNoun (mkN "Vorgänger" "Vorgänger" masculine) ;
lin preorder_Noun = mkNoun (mkN "Präordnung" "Präordnungen" feminine) ;
lin procedure_Noun = mkNoun (mkN "Verfahren" "Verfahren" neuter) ;
lin supremum_Noun = mkNoun (mkN "Supremum" "Suprema" neuter) ;

}
