concrete HottWordsFre of HottWords = CategoriesFre **

open UtilitiesFre, ParadigmsFre in {

lin homotopic_Adj = mkAdj "homotopique" ;
lin reflexivity_Noun = mkNoun (mkN "reflexivité") ;

-- words of the Mathlib informalization
lin coprime_Adj = mkAdj (mkA "premier entre eux" "première entre elles" "premiers entre eux" "premières entre elles") ;
lin factor_Noun = mkNoun (mkN "facteur" masculine) ;
lin predecessor_Noun = mkNoun (mkN "prédécesseur" masculine) ;
lin preorder_Noun = mkNoun (mkN "préordre" masculine) ;
lin procedure_Noun = mkNoun (mkN "procédure" feminine) ;
lin supremum_Noun = mkNoun (mkN "supremum" masculine) ;

}
